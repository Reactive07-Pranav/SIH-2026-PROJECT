# Shared ports — keep frontend and backend in lockstep.
# Copy to .env for local overrides. Vite only reads FRONTEND/.env.local for VITE_*.

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Browser talks to the API on the host-mapped port (also used inside Vite proxy).
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# React (Vite) — baked in at `npm run dev` / `npm run build` start. Restart Vite after changing.
VITE_API_URL=http://localhost:8000

# FastAPI CORS allowlist (comma-separated). Never use * together with allow_credentials=True.
CORS_ORIGINS=http://localhost:5173
# Optional regex for origins that change per deploy (Vercel previews). Set by render.yaml on Render.
# CORS_ORIGIN_REGEX=https://sih-2026-project[a-z0-9-]*\.vercel\.app

# 1 = create demo accounts (OP001/test123, admin/admin123) + synthetic records at startup. Off by default.
SEED_DEMO=

# Local default is SQLite. Docker Compose overrides this to Postgres on host `db`.
DATABASE_URL=sqlite:///./drugdb.sqlite

# Leave empty for a random per-process secret. Set a long random value for stable tokens:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional: serve `npm run build` output from FastAPI (same origin, no CORS).
# FRONTEND_DIST=../FRONTEND/dist
